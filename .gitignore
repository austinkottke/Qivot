# Build output
build/
*.o
*.obj
*.a
*.so
*.dylib
*.dll
moc_*.cpp
moc_*.h
moc_*.json
qrc_*.cpp
ui_*.h
Makefile*
*.pro.user*
.qmake.stash

# qmake QML type-registration output
*.qmltypes
*_metatypes.json
*_qmltyperegistrations.cpp

# SQLite databases written by examples at runtime (keeps tests/…/tests.db tracked)
examples/**/*.db
*.db-wal
*.db-shm

# Built example binaries (sit next to their sources)
examples/fluxo/fluxo
examples/lexica/lexica
examples/clinic/clinic
examples/qivot-wasm-demo/qivotwasmdemo

# WebAssembly build output (from a wasm qmake build in an example dir)
examples/*/*.wasm
examples/*/*.data
examples/*/qtloader.js
examples/qivot-wasm-demo/qivotwasmdemo.html
examples/qivot-wasm-demo/qivotwasmdemo.js

# macOS
.DS_Store

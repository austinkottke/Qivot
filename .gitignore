# Built example binaries (sit next to their sources)
examples/fluxo/fluxo
examples/lexica/lexica
examples/clinic/clinic

# WebAssembly build output (from a wasm qmake build in an example dir)
examples/*/*.wasm
examples/*/*.data
examples/*/qtloader.js
examples/clinic/clinic.html
examples/clinic/clinic.js


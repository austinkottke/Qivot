{
  "name": "qivot",
  "version": "1.0.5",
  "description": "Qt ORM: declare models in C++, query and migrate SQLite, PostgreSQL, MySQL, SQL Server and DuckDB, and map JSON (optionally over HTTP) onto them.",
  "homepage": "https://github.com/austinkottke/Qivot",
  "license": "MIT",
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "qtbase",
      "default-features": false,
      "features": [
        "sql"
      ]
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "default-features": [
    "sqlite"
  ],
  "features": {
    "network": {
      "description": "QiJsonRequest: load JSON over HTTP on a worker thread (Qt Network)",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "network"
          ]
        }
      ]
    },
    "sqlite": {
      "description": "Qt's SQLite driver (QSQLITE), so the default database works out of the box",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": [
            "sql-sqlite"
          ]
        }
      ]
    }
  }
}
